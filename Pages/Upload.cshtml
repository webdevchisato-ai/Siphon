@page
@model Siphon.Pages.UploadModel
@{
    ViewData["Title"] = "Upload";
}

<div class="container d-flex flex-column align-items-center justify-content-center" style="min-height: 80vh;">

    <div class="text-center w-100" style="max-width: 800px;">
        <h1 class="display-4 mb-4 text-secondary">File Upload</h1>

        <div id="dropZone" class="border border-3 border-dashed rounded-4 p-5 text-center bg-light position-relative transition-all"
             style="cursor: pointer; min-height: 300px; display: flex; flex-direction: column; justify-content: center; align-items: center;">

            <div class="mb-3">
                <i class="bi bi-cloud-arrow-up text-primary" style="font-size: 5rem;"></i>
            </div>
            <h3 class="fw-light">Drag & Drop files here</h3>
            <p class="text-muted">or click to browse</p>

            <div class="position-absolute top-0 start-0 w-100 h-100 rounded-4"
                 style="pointer-events: none; background: rgba(13, 110, 253, 0.05); opacity: 0; transition: opacity 0.2s;"
                 id="hoverOverlay"></div>
        </div>
    </div>

    <div class="modal fade" id="uploadModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <form method="post" enctype="multipart/form-data" id="uploadForm">

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">Finalize Upload</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body p-4">
                        <div class="alert alert-primary d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-file-earmark-text fs-4 me-3"></i>
                            <div class="overflow-hidden">
                                <small class="text-uppercase text-primary fw-bold" style="font-size: 0.7rem;">Selected File</small>
                                <div id="modalFileName" class="fw-bold text-truncate">filename.ext</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Target URL</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-link-45deg"></i></span>
                                <input type="url" class="form-control" asp-for="TargetUrl" placeholder="https://siphon/file" required />
                            </div>
                        </div>

                        <input type="file" asp-for="UploadFile" class="d-none" id="fileInput" required />
                    </div>

                    <div class="modal-footer border-0 pt-0 px-4 pb-4">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-send-fill me-2"></i>Upload
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

<style>
    /* Custom Styling for the dashed border and hover effects */
    #dropZone {
        border-color: #dee2e6 !important;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

        #dropZone:hover {
            border-color: #0d6efd !important;
            transform: translateY(-5px);
        }

            #dropZone:hover #hoverOverlay {
                opacity: 1;
            }

        #dropZone.drag-active {
            border-color: #0d6efd !important;
            background-color: #e9ecef !important;
            transform: scale(1.02);
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const uploadForm = document.getElementById('uploadForm');

        // Bootstrap Modal Instance
        const uploadModal = new bootstrap.Modal(document.getElementById('uploadModal'));
        const modalFileName = document.getElementById('modalFileName');

        // 1. Click Interaction
        dropZone.addEventListener('click', () => fileInput.click());

        // 2. Handle File Selection (via Click)
        fileInput.addEventListener('change', () => {
            if (fileInput.files.length > 0) {
                openModalWithFile(fileInput.files[0]);
            }
        });

        // 3. Drag and Drop Interaction
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, preventDefaults, false);
        });

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        // Add visual cues when dragging over
        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => dropZone.classList.add('drag-active'), false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => dropZone.classList.remove('drag-active'), false);
        });

        // Handle the Drop
        dropZone.addEventListener('drop', (e) => {
            const dt = e.dataTransfer;
            const files = dt.files;

            if (files.length > 0) {
                // IMPORTANT: We must manually assign the dropped files to the file input
                // so they are included when the form submits.
                fileInput.files = files;
                openModalWithFile(files[0]);
            }
        });

        // Helper to update UI and show Modal
        function openModalWithFile(file) {
            modalFileName.innerText = file.name;
            uploadModal.show();
        }

        // Reset file input if modal is closed without uploading
        document.getElementById('uploadModal').addEventListener('hidden.bs.modal', () => {
           // Optional: clear input if you want to force re-selection on close
           // fileInput.value = '';
        });
    });
</script>