@page
@model Siphon.Pages.UploadModel
@{
    ViewData["Title"] = "Upload";
}

<div class="container d-flex flex-column align-items-center justify-content-center" style="min-height: 80vh;">

    <div class="text-center w-100" style="max-width: 800px;">
        <h1 class="display-4 mb-4 text-secondary">File Upload</h1>

        <div id="dropZone" class="border border-3 border-dashed rounded-4 p-5 text-center bg-light position-relative transition-all"
             style="cursor: pointer; min-height: 300px; display: flex; flex-direction: column; justify-content: center; align-items: center;">

            <div class="mb-3">
                <i class="bi bi-cloud-arrow-up text-primary" style="font-size: 5rem;"></i>
            </div>
            <h3 class="fw-light">Drag & Drop files here</h3>
            <p class="text-muted">or click to browse</p>

            <div class="position-absolute top-0 start-0 w-100 h-100 rounded-4"
                 style="pointer-events: none; background: rgba(13, 110, 253, 0.05); opacity: 0; transition: opacity 0.2s;"
                 id="hoverOverlay"></div>
        </div>
    </div>

    <div class="modal fade" id="uploadModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <form method="post" enctype="multipart/form-data" id="uploadForm">
                    @Html.AntiForgeryToken()

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">Finalize Upload</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="modalCloseBtn"></button>
                    </div>

                    <div class="modal-body p-4">
                        <div class="alert alert-primary d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-file-earmark-text fs-4 me-3"></i>
                            <div class="overflow-hidden">
                                <small class="text-uppercase text-primary fw-bold" style="font-size: 0.7rem;">Selected File</small>
                                <div id="modalFileName" class="fw-bold text-truncate">filename.ext</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Target URL</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-link-45deg"></i></span>
                                <input type="url" class="form-control" asp-for="TargetUrl" placeholder="https://siphon/file" required />
                            </div>
                        </div>

                        <div id="progressContainer" class="d-none mt-4">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="small fw-bold text-muted">Uploading...</span>
                                <span id="progressText" class="small fw-bold text-primary">0%</span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%"></div>
                            </div>
                        </div>

                        <input type="file" asp-for="UploadFile" class="d-none" id="fileInput" required />
                    </div>

                    <div class="modal-footer border-0 pt-0 px-4 pb-4">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal" id="cancelBtn">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4" id="uploadBtn">
                            <i class="bi bi-send-fill me-2"></i>Upload
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

<style>
    /* Custom Styling for the dashed border and hover effects */
    #dropZone {
        border-color: #dee2e6 !important;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

        #dropZone:hover {
            border-color: #0d6efd !important;
            transform: translateY(-5px);
        }

            #dropZone:hover #hoverOverlay {
                opacity: 1;
            }

        #dropZone.drag-active {
            border-color: #0d6efd !important;
            background-color: #e9ecef !important;
            transform: scale(1.02);
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const uploadForm = document.getElementById('uploadForm');

        // UI Elements for Progress
        const progressContainer = document.getElementById('progressContainer');
        const progressBar = document.getElementById('uploadProgressBar');
        const progressText = document.getElementById('progressText');
        const uploadBtn = document.getElementById('uploadBtn');
        const cancelBtn = document.getElementById('cancelBtn');
        const modalCloseBtn = document.getElementById('modalCloseBtn');

        // Bootstrap Modal Instance
        const uploadModal = new bootstrap.Modal(document.getElementById('uploadModal'));
        const modalFileName = document.getElementById('modalFileName');

        // 1. Click Interaction
        dropZone.addEventListener('click', () => fileInput.click());

        // 2. Handle File Selection (via Click)
        fileInput.addEventListener('change', () => {
            if (fileInput.files.length > 0) {
                openModalWithFile(fileInput.files[0]);
            }
        });

        // 3. Drag and Drop Interaction
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, preventDefaults, false);
        });

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        // Add visual cues when dragging over
        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => dropZone.classList.add('drag-active'), false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => dropZone.classList.remove('drag-active'), false);
        });

        // Handle the Drop
        dropZone.addEventListener('drop', (e) => {
            const dt = e.dataTransfer;
            const files = dt.files;

            if (files.length > 0) {
                fileInput.files = files;
                openModalWithFile(files[0]);
            }
        });

        // Helper to update UI and show Modal
        function openModalWithFile(file) {
            modalFileName.innerText = file.name;
            // Reset UI state
            progressContainer.classList.add('d-none');
            uploadBtn.disabled = false;
            cancelBtn.disabled = false;
            modalCloseBtn.disabled = false;
            uploadBtn.innerHTML = '<i class="bi bi-send-fill me-2"></i>Upload';
            uploadModal.show();
        }

        // 4. Handle Form Submission with AJAX for Progress
        uploadForm.addEventListener('submit', function (e) {
            e.preventDefault(); // Stop standard form submit

            const formData = new FormData(uploadForm);
            const xhr = new XMLHttpRequest();

            // Get Anti-Forgery Token
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            // Setup UI for upload
            progressContainer.classList.remove('d-none');
            uploadBtn.disabled = true;
            cancelBtn.disabled = true;
            modalCloseBtn.disabled = true;
            uploadBtn.innerText = 'Uploading...';
            progressBar.style.width = '0%';
            progressText.innerText = '0%';

            // Monitor Progress
            xhr.upload.addEventListener('progress', function (e) {
                if (e.lengthComputable) {
                    const percentComplete = Math.round((e.loaded / e.total) * 100);
                    progressBar.style.width = percentComplete + '%';
                    progressText.innerText = percentComplete + '%';
                }
            });

            // Handle Completion
            xhr.onload = function () {
                if (xhr.status === 200) {
                    progressBar.classList.remove('progress-bar-animated');
                    progressBar.classList.add('bg-success');
                    uploadBtn.innerText = 'Done!';

                    // Reload the page to show new state (or follow redirect)
                    window.location.reload();
                } else {
                    // Error Handling
                    console.error('Upload failed:', xhr.responseText);
                    alert('Upload failed. Status: ' + xhr.status);
                    resetModalUI();
                }
            };

            xhr.onerror = function () {
                alert('An error occurred during the upload.');
                resetModalUI();
            };

            // Send to the current page URL (OnPostAsync)
            xhr.open('POST', window.location.href, true);

            // Set the verification token header
            xhr.setRequestHeader("RequestVerificationToken", token);

            xhr.send(formData);
        });

        function resetModalUI() {
            uploadBtn.disabled = false;
            cancelBtn.disabled = false;
            modalCloseBtn.disabled = false;
            uploadBtn.innerHTML = '<i class="bi bi-send-fill me-2"></i>Upload';
        }

        document.getElementById('uploadModal').addEventListener('hidden.bs.modal', () => {
             // Optional clean up
        });
    });
</script>