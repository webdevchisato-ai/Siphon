@using Siphon.Pages
@model Siphon.Pages.ExternalIntegrationsModel

@if (Model.ViewMode == "posts" && Model.ReturnToArtists)
{
    <div class="alert alert-secondary d-flex justify-content-between align-items-center mb-4 shadow-sm border-0">
        <div>
            <i class="bi bi-person-circle me-2"></i> Viewing posts for artist <strong>@Model.SearchUser</strong>
        </div>
        <button onclick="backToArtists()" class="btn btn-sm btn-outline-dark">
            <i class="bi bi-arrow-left"></i> Back to Artists
        </button>
    </div>
}

@if (Model.ViewMode == "artists")
{
    if (Model.Creators == null || Model.Creators.Count == 0)
    {
        <div class="text-center py-5">
            <div class="mb-3"><i class="bi bi-search text-secondary" style="font-size: 4rem;"></i></div>
            <h4 class="fw-bold text-muted">No Artists Found</h4>
            <p class="text-muted">Try adjusting your filters.</p>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold">Artists</h4>
            <span class="badge bg-secondary">@Model.Creators.Count items shown</span>
        </div>

        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var creator in Model.Creators)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 post-card"
                         oncontextmenu="showContextMenu(event, 'artist', '@creator.OriginalUrl', this, '@creator.Id', '@creator.Service')">
                        <div class="position-relative bg-black rounded-top overflow-hidden" style="height: 180px;">
                            @if (!string.IsNullOrEmpty(creator.ProfileIconUrl))
                            {
                                <img data-src="?handler=ProxyImage&url=@System.Web.HttpUtility.UrlEncode(creator.ProfileIconUrl)"
                                     class="lazy-image w-100 h-100 img-loading"
                                     style="object-fit: cover;"
                                     alt="Artist Avatar" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-secondary">
                                    <i class="bi bi-person fs-1 text-white-50"></i>
                                </div>
                            }
                        </div>

                        <div class="card-body">
                            <small class="text-uppercase text-primary fw-bold" style="font-size: 0.7rem;">@creator.Service</small>
                            <h6 class="card-title text-truncate fw-bold mb-1" title="@creator.Name">@creator.Name</h6>
                            <small class="text-muted d-block mb-2 text-truncate">ID: @creator.Id</small>

                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-star-fill text-warning"></i> @creator.Favorited
                                </span>
                                <small class="text-muted" style="font-size: 0.75rem;">
                                    @if (Model.ArtistSortMode == "indexed")
                                    {
                                        <span>Idx: @creator.Indexed.ToShortDateString()</span>
                                    }
                                    else
                                    {
                                        <span>Upd: @creator.Updated.ToShortDateString()</span>
                                    }
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    if (Model.Posts == null || Model.Posts.Count == 0)
    {
        <div class="text-center py-5">
            <div class="mb-3"><i class="bi bi-search text-secondary" style="font-size: 4rem;"></i></div>
            <h4 class="fw-bold text-muted">No Results Found</h4>
            <p class="text-muted">Try adjusting your filters.</p>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold">Results</h4>
            <span class="badge bg-secondary">@Model.Posts.Count items shown</span>
        </div>

        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var post in Model.Posts)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 post-card"
                         oncontextmenu="showContextMenu(event, 'post', '@post.OriginalUrl', this, '', '')">
                        <div class="position-relative bg-black rounded-top overflow-hidden" style="height: 180px;">

                            <div class="queued-badge">
                                <i class="bi bi-check-circle-fill fs-1 mb-2"></i>
                                <span class="fw-bold">Queued!</span>
                            </div>

                            <div class="preview-indicator" id="preview-icon-@post.Id" style="display: none; position: absolute; top: 8px; left: 8px; z-index: 10; background: rgba(0,0,0,0.6); border-radius: 4px; padding: 2px 6px; color: #0dcaf0; font-size: 0.75rem;">
                                <i class="bi bi-film"></i> Preview
                            </div>
                            <video class="preview-video" id="preview-vid-@post.Id" preload="metadata" loop muted playsinline style="display: none; width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; z-index: 5; opacity: 0; transition: opacity 0.3s; pointer-events: none;"></video>

                            @if (!string.IsNullOrEmpty(post.ThumbnailUrl))
                            {
                                <img data-src="?handler=ProxyImage&url=@System.Web.HttpUtility.UrlEncode(post.ThumbnailUrl)"
                                     data-duration="@(post.HasVideo ? (post.FirstVideoUrl ?? post.ThumbnailUrl) : "")"
                                     class="lazy-image w-100 h-100 img-loading"
                                     style="object-fit: cover; position: relative; z-index: 1;"
                                     alt="Post Thumbnail" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-secondary" style="position: relative; z-index: 1;">
                                    <i class="bi @(post.HasVideo ? "bi-play-circle-fill" : "bi-image") fs-1 text-white-50"></i>
                                </div>
                            }

                            @if (post.HasVideo)
                            {
                                <span class="position-absolute top-0 end-0 badge bg-danger m-2 shadow-sm" style="z-index: 10;">VIDEO</span>
                                <span class="duration-badge" data-duration-display style="display: @(post.VideoDuration > 0 ? "block" : "none"); z-index: 10;">
                                    @if (post.VideoDuration > 0)
                                    {
                                        TimeSpan t = TimeSpan.FromSeconds(post.VideoDuration);
                                        string answer = string.Format("{0:D2}:{1:D2}", t.Minutes, t.Seconds);
                                        if (t.Hours > 0) answer = string.Format("{0:D2}:{1:D2}:{2:D2}", t.Hours, t.Minutes, t.Seconds);
                                        @answer
                                    }
                                    else
                                    {
                                        @:--:--
                                    }
                                </span>
                            }
                        </div>

                        <div class="card-body">
                            <small class="text-uppercase text-primary fw-bold" style="font-size: 0.7rem;">@post.Service</small>
                            <h6 class="card-title text-truncate fw-bold mb-1" title="@post.Title">@post.Title</h6>
                            <small class="text-muted d-block mb-2 text-truncate">@post.User</small>

                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-paperclip"></i> @post.AttachmentCount
                                </span>
                                <small class="text-muted" style="font-size: 0.75rem;">@post.Published.ToShortDateString()</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}